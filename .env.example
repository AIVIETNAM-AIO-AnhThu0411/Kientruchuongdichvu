# Chọn theo Authentication trong SSMS: windows hoặc sql.
DB_AUTH=windows
DB_SERVER=localhost
DB_DATABASE=quan_ly_tro
DB_DRIVER=ODBC Driver 17 for SQL Server

# Ví dụ SSMS Server name là LAPTOP-ABC\SQLEXPRESS:
# DB_SERVER=LAPTOP-ABC; DB_INSTANCE=SQLEXPRESS; DB_PORT để trống.
DB_INSTANCE=
DB_PORT=1433

# Chỉ điền nếu DB_AUTH=sql. Đây là login kết nối SQL Server,
# KHÁC email/mật khẩu tài khoản Admin trong bảng [user].
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SESSION_HOURS=8
LOGIN_LIMIT=10
